# Backend hosts for the ZBROwner app.
#
# Expo inlines EXPO_PUBLIC_* variables into the JS bundle at BUILD time — they
# are not read at runtime. So the values present when you bundle are the values
# shipped to the vendor's phone. Changing them later requires a rebuild.
#
# Which file is loaded:
#   .env              always (lowest precedence) — use for local development
#   .env.development  when NODE_ENV=development (metro dev server)
#   .env.production   when NODE_ENV=production  (release builds: bundleRelease)
#   .env.local        always, overrides the above, gitignored — machine-specific
#
# Copy this file to `.env` for local development.
#
# Local dev against a backend on your LAN: use your computer's LAN IP, NOT
# localhost — a physical device cannot reach the dev machine's localhost:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080
#   EXPO_PUBLIC_WS_BASE_URL=ws://192.168.1.50:8080
#
# RELEASE builds MUST use https:// and wss:// — iOS ATS and the Android
# cleartext policy block plain http/ws, so a release build pointed at http://
# simply cannot reach the backend. Put those in `.env.production`.
#
# Verify what actually got baked in before uploading:  npm run check:release

EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080
