# Backend hosts for the ZBROwner app.
# Copy to `.env` for local development. Expo inlines EXPO_PUBLIC_* vars into the
# bundle at build time. For device/preview/production builds, set these in the
# corresponding EAS build profile (eas.json) instead of relying on this file.
#
# Local dev against a machine on your LAN: use your computer's LAN IP, not
# localhost (a physical device can't reach the dev machine's localhost).
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080
#   EXPO_PUBLIC_WS_BASE_URL=ws://192.168.1.50:8080
#
# Staging / production MUST be https:// and wss:// (iOS ATS + Android cleartext
# policy block plain http/ws in release builds):
#   EXPO_PUBLIC_API_BASE_URL=https://api.staging.zbr.example.com
#   EXPO_PUBLIC_WS_BASE_URL=wss://api.staging.zbr.example.com

EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080
