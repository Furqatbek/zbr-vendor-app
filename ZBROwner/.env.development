# Loaded when NODE_ENV=development — i.e. `expo start`, `expo run:android`,
# and any debug build.
#
# Points development at PRODUCTION on purpose. The previous behaviour was to
# fall back to http://localhost:8080, which a physical device can never reach,
# so every dev build on a real phone failed with an opaque network error.
#
# To develop against a local backend instead, create `.env.local` (gitignored,
# machine-specific, and it overrides this file):
#
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8080
#   EXPO_PUBLIC_WS_BASE_URL=ws://192.168.1.50:8080
#
# Use your machine's LAN IP, not localhost — the phone resolves localhost to
# itself. Restart with `npx expo start --clear` after changing any env file;
# these values are inlined at bundle time and Metro caches them.

EXPO_PUBLIC_API_BASE_URL=https://zbrr.uz
EXPO_PUBLIC_WS_BASE_URL=wss://zbrr.uz
