# Production backend for release builds.
#
# NOTE: the base URL must NOT include /api/v1 — every entry in
# constants/api.ts already carries that prefix and URLs are built as
# `${API_BASE_URL}${endpoint}`. Adding it here yields
# https://zbrr.uz/api/v1/api/v1/... which the server answers with 401,
# and the client reads 401 as an expired session and logs the vendor out.
EXPO_PUBLIC_API_BASE_URL=https://zbrr.uz
EXPO_PUBLIC_WS_BASE_URL=wss://zbrr.uz
