{
  "name": "zbrowner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:push": "node scripts/check-push-config.js",
    "test": "jest",
    "test:ci": "jest --ci --runInBand"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@stomp/.*))"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@stomp/stompjs": "^7.3.0",
    "babel-preset-expo": "~55.0.8",
    "eslint-config-expo": "~55.0.1",
    "expo": "~55.0.8",
    "expo-application": "~55.0.10",
    "expo-av": "^16.0.8",
    "expo-constants": "^55.0.9",
    "expo-haptics": "^55.0.9",
    "expo-image-picker": "~55.0.13",
    "expo-linking": "^55.0.8",
    "expo-localization": "~55.0.9",
    "expo-location": "~55.1.11",
    "expo-notifications": "^55.0.13",
    "expo-router": "^55.0.7",
    "expo-secure-store": "~55.0.15",
    "expo-status-bar": "~55.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.19",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-reanimated": "^4.2.3",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
